---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- comment -%} Fixed pages. Add a new page to this list when you create one. {%- endcomment -%}
{%- assign fixed_pages = "/,/news/,/releases.html,/streams.html,/photo.html,/license.html,/privacy.html" | split: "," -%}
{%- for fixed in fixed_pages %}
    <url><loc>{{ fixed | absolute_url }}</loc></url>
{%- endfor %}
{%- comment -%} Biographies: one entry per language file in the folder _bio, each one lists all language versions (hreflang). {%- endcomment -%}
{%- assign default_bio = site.bio | where: "lang", "en" | first -%}
{%- for item in site.bio %}
    <url>
        <loc>{{ item.url | absolute_url | xml_escape }}</loc>
        {%- for alt in site.bio %}
        <xhtml:link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url | absolute_url | xml_escape }}"/>
        {%- endfor %}
        {%- if default_bio %}
        <xhtml:link rel="alternate" hreflang="x-default" href="{{ default_bio.url | absolute_url | xml_escape }}"/>
        {%- endif %}
    </url>
{%- endfor %}
{%- comment -%} News articles. Entries that point to an old page use that old address. {%- endcomment -%}
{%- for post in site.posts %}
    <url>
        <loc>{{ post.legacy_url | default: post.url | uri_escape | absolute_url | xml_escape }}</loc>
        {%- if post.updated and post.updated != "" %}
        <lastmod>{{ post.updated | date_to_xmlschema }}</lastmod>
        {%- endif %}
    </url>
{%- endfor %}
{%- comment -%} Song lyrics pages (folder "lyrics", layout "lyrics"). {%- endcomment -%}
{%- assign sm_lyrics = site.pages | where: "layout", "lyrics" -%}
{%- for item in sm_lyrics %}
    <url><loc>{{ item.url | absolute_url | xml_escape }}</loc></url>
{%- endfor %}
</urlset>
